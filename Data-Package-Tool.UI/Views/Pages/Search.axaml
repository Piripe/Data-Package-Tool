<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:pages="clr-namespace:DataPackageTool.UI.Views.Pages"
             xmlns:c="clr-namespace:DataPackageTool.UI.Controls"
             x:Class="DataPackageTool.UI.Views.Pages.Search"
			 x:DataType="pages:SearchViewModel">
	<Design.DataContext>
		<pages:SearchViewModel />
	</Design.DataContext>
	<Grid ColumnDefinitions="240,*">
		<Grid Background="{DynamicResource BackgroundSecondary}"/>
		<Grid Grid.Column="1" RowDefinitions="36,*">
			<Border Padding="8 8 8 0">
				<TextBox Text="{CompiledBinding Mode=TwoWay, Path=SearchText}"/>
			</Border>
			<c:DiscordMessageList x:Name="Results" Grid.Row="1" Messages="{CompiledBinding Results}">
				<c:DiscordMessageList.MessageContextMenu>
					<MenuItem x:Name="OpenChannelButton" Header="Open channel"/>
				</c:DiscordMessageList.MessageContextMenu>	
			</c:DiscordMessageList>
		</Grid>
	</Grid>
</UserControl>
