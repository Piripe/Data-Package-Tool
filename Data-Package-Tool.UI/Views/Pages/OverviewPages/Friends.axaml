<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:c="clr-namespace:DataPackageTool.UI.Controls"
             xmlns:opages="clr-namespace:DataPackageTool.UI.Views.Pages.OverviewPages"
             x:Class="DataPackageTool.UI.Friends"
			 x:DataType="opages:FriendsViewModel">
	<StackPanel Orientation="Vertical" Spacing="4" Margin="0 4 0 0">
		<Border Classes="Card">
			<DataGrid Margin="4" ItemsSource="{CompiledBinding ChannelsDataGrid}"
					  IsReadOnly="True"
					  CanUserReorderColumns="True"
					  CanUserResizeColumns="True"
					  CanUserSortColumns="True"
					  Height="384">
				<DataGrid.Columns>
					<DataGridTextColumn Header="User" Binding="{CompiledBinding DMRecipient.DisplayName}"/>
					<DataGridTextColumn Header="Messages Sent" Binding="{CompiledBinding Messages.Count}"/>
				</DataGrid.Columns>
			</DataGrid>
		</Border>
    </StackPanel>
</UserControl>
