<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:DataPackageTool.UI.Views.Pages.OverviewPages"
			 xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DataPackageTool.UI.Views.Pages.OverviewPages.Notifications"
			 x:DataType="local:NotificationsViewModel">
	<StackPanel Orientation="Vertical" Spacing="4" Margin="0 8 0 0">
		<UniformGrid Columns="2" ColumnSpacing="4">
			<Border Classes="Card">
				<StackPanel>
					<TextBlock Classes="h3" HorizontalAlignment="Center" Text="Notifications clicked per month"/>
					<lvc:CartesianChart Height="360" Series="{CompiledBinding MonthlyClickedNotificationsSeries}" XAxes="{CompiledBinding MonthXAxis}" YAxes="{CompiledBinding BaseYAxis}" ZoomMode="X"/>
				</StackPanel>
			</Border>
			<Border Classes="Card">
				<StackPanel>
					<TextBlock Classes="h3" HorizontalAlignment="Center" Text="Notifications clicked activity"/>
					<lvc:CartesianChart Height="360" Series="{CompiledBinding NotificationsClickedActivityHeatmapSeries}" XAxes="{CompiledBinding WeekHeatmapXAxis}" YAxes="{CompiledBinding WeekHeatmapYAxis}" ZoomMode="PanX" CornerRadius="4"/>
				</StackPanel>
			</Border>
		</UniformGrid>
	</StackPanel>
</UserControl>
