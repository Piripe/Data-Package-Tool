<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:DataPackageTool.UI.Views.Pages"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DataPackageTool.UI.Views.Pages.Server"
			 x:DataType="pages:ServerViewModel">
	<Design.DataContext>
		<pages:ServerViewModel />
	</Design.DataContext>
	<Grid>
		<TextBlock Text="{CompiledBinding Name}" Classes="h1"/>
	</Grid>
</UserControl>
